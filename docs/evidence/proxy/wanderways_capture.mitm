d;36:f7420a33-fedd-455f-a096-c4a0d0da9c15;8:sockname;19:9:127.0.0.1;4:8081#]8:peername;20:9:127.0.0.1;5:49722#]}5:error;0:~2:id;36:2d02fb4f-070b-4fb6-b7b2-fc4ad555cfcc;4:type;4:http;7:version;2:21#}2508:9:websocket;0:~8:response;808:6:reason;2:OK,11:status_code;3:200#13:timestamp_end;18:1795225443.7954898^15:timestamp_start;18:1795225443.7949302^8:trailers;0:~7:content;418:{"id":5,"booking_ref":"WW-26-1005","customer_id":4,"customer_name":"Ayesha Khan","agent_id":2,"agent_name":"Sara Malik","destination":"Hunza Valley, Pakistan","hotel":"Karimabad Heights","depart_date":"2027-03-19","return_date":"2027-03-28","travellers":4,"total_price":1830.0,"status":"cancelled","passport_no":"ZX9778116","payment_last4":"1680","notes":"Late check-out requested","created_at":"2026-11-19 12:49:00"}
