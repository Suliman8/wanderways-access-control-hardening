nd;18:1795225443.7728338^15:timestamp_start;18:1795225443.7723446^8:trailers;0:~7:content;1918:<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Booking 5 · WanderWays Travel</title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body data-page="bookingDetail" data-user-id="2" data-booking-id="5">
  <div class="lab-banner">Training lab · intentionally vulnerable · run on 127.0.0.1 only</div>
  <header class="topbar">
    <a class="brand" href="/">Wander<span>Ways</span> <small>Travel</small></a>
    
    <nav>
      <a href="/dashboard">Bookings</a>
      
      <a href="/profile">Profile</a>
      
      <span class="who">Sara Malik <span class="role role-agent">agent</span></span>
      <a id="logout-link" class="logout" href="/logout">Log out</a>
    </nav>
    
  </header>
  <main class="container">
    <div id="page-message" class="message" hidden></div>
    
<p><a href="/dashboard">&larr; Back to bookings</a></p>
<section class="card">
  <div class="card-head">
    <h1 id="booking-title">Booking</h1>
    <span id="booking-status"></span>
  </div>
  <dl id="booking-details" class="details"></dl>
</section>

<section class="card">
  <h2>Change booking</h2>
  <form id="booking-edit-form" class="grid-form">
    <label>Departure <input type="date" name="depart_date" required></label>
    <label>Return <input type="date" name="return_date" required></label>
    <label>Travellers <input type="number" name="travellers" min="1" max="9" required></label>
    <label class="wide">Notes <input name="notes" maxlength="200"></label>
    <div class="actions wide">
      <button type="submit">Save changes</button>
      <button type="button" id="cancel-booking" class="danger">Cancel booking</button>
    </div>
  </form>
</section>

  </main>
  <footer>WanderWays Travel · internal booking prototype · Ezitech</footer>
  <script src="/static/js/app.js"></script>
</body>
</html>,7:headers;213:42:6:Server,29:Werkzeug/3.1.9 Python/3.13.12,]40:4:Date,29:Sat, 21 Nov 2026 01:44:03 GMT,]44:12:Content-Type,24:text/html; charset=utf-8,]25:14:Content-Length,4:1918,]16:4:Vary,6:Cookie,]22:10:Connection,5:close,]]12:http_version;8:HTTP/1.1,}7:request;543:4:path;11:/bookings/5,9:authority;0:,6:scheme;4:http,6:method;3:GET,4:port;4:5000#4:host;9:127.0.0.1;13:timestamp_end;17:1795225443.769114^15:timestamp_start;18:1795225443.7686672^8:trailers;0:~7:content;0:,7:headers;294:25:4:Host,14:127.0.0.1:5000,]56:10:User-Agent,38:WanderWays-traffic-generator/1.0 (lab),]36:15:Accept-Encoding,13:gzip, deflate,]15:6:Accept,3:*/*,]28:10:Connection,10:keep-alive,]109:6:Cookie,96:ww_role=agent; session=eyJ1c2VyX2lkIjoyLCJyb2xlIjoiYWdlbnQifQ.awD3Yw.-yEKZKll_blvemXBDOjfqhQH1Bs,]]12:http_version;8:HTTP/1.1,}6:backup;0:~17:timestamp_created;18:1795225443.7688098^7:comment;0:;8:metadata;0:}6:marked;0:;9:is_replay;0:~11:intercepted;5:false!11:server_conn;448:3:via;0:~19:timestamp_tcp_setup;18:1795225443.7701116^7:address;19:9:127.0.0.1;4:5000#]19:timestamp_tls_setup;0:~13:timestamp_end;0:~15:timestamp_start;17:1795225443.769762^3:sni;0:~11:tls_version;0:~11:cipher_list;0:]6:cipher;0:~11:alpn_offers;0:]4:alpn;0:~16:certificate_list;0:]3:tls;5:false!5:error;0:~18:transport_protocol;3:tcp;2:id;36:0fdfb29b-732f-467e-b783-5e8c144ea78e;8:sockname;20:9:127.0.0.1;5:39296#]8:peername;19:9:127.0.0.1;4:5000#]}11:client_conn;400:10:proxy_mode;7:regular;8:mitmcert;0:~19:timestamp_tls_setup;0:~13:timestamp_end;0:~15:timestamp_start;18:1795225443.7676861^3:sni;0:~11:tls_version;0:~11:cipher_list;0:]6:cipher;0:~11:alpn_offers;0:]4:alpn;0:~16:certificate_list;0:]3:tls;5:false!5:error;0:~18:transport_protocol;3:tcp;2:id;36:95bf5438-5ce9-44b9-b014-deeade4c7fcd;8:sockname;19:9:127.0.0.1;4:8081#]8:peername;20:9:127.0.0.1;5:49706#]}5:error;0:~2:id;36:52d1cff5-3aaa-4d8f-84c6-71fab654f54d;4:type;4:http;7:version;2:21#}6735:9:websocket;0:~8:response;5029:6:reason;2:OK,11:status_code;3:200#13:timestamp_end;18:1795225443.7803154^15:timestamp_start;18:1795225443.7798374^8:trailers;0:~7:content;4363::root {
  --bg: #f4f6fa;
  --surface: #ffffff;
  --text: #1c2433;
  --muted: #667085;
  --line: #e3e7ef;
  --brand: #0f6cbd;
  --brand-dark: #0b4f8a;
  --danger: #c0392b;
  --ok: #1e8e5a;
  --warn: #b7791f;
  --radius: 10px;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
}

a { color: var(--brand); }

.lab-banner {
  background: #fff4e5;
  color: #8a5300;
  font-size: 0.8rem;
  text-align: center;
  padding: 4px 16px;
  border-bottom: 1px solid #f5d9a8;
}

.topbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 24px;
  background: var(--surface);
  border-bottom: 1px solid var(--line);
}

.brand { font-size: 1.3rem; font-weight: 700; color: var(--text); text-decoration: none; }
.brand span { color: var(--brand); }
.brand small { font-weight: 500; color: var(--muted); font-size: 0.85rem; }

nav { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
nav a { text-decoration: none; font-weight: 500; }
nav .who { color: var(--muted); font-size: 0.9rem; }

.role {
  display: inline-block;
  padding: 1px 8px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.role-admin { background: #fde8e8; color: #9b1c1c; }
.role-agent { background: #e6f0fb; color: var(--brand-dark); }
.role-customer { background: #e7f6ee; color: #146c43; }

.container { max-width: 1080px; margin: 24px auto; padding: 0 16px; }

.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 20px 24px;
  margin-bottom: 20px;
}
.card.narrow { max-width: 440px; margin: 40px auto; }
.card-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }

h1 { font-size: 1.4rem; margin: 0 0 12px; }
h2 { font-size: 1.1rem; margin: 0 0 12px; }
.muted { color: var(--muted); }

.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
th { color: var(--muted); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }
tbody tr:hover { background: #f8fafd; }

.badge { padding: 2px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; }
.badge-confirmed { background: #e7f6ee; color: var(--ok); }
.badge-pending { background: #fdf3e1; color: var(--warn); }
.badge-cancelled { background: #fde8e8; color: var(--danger); }

form label { display: block; font-weight: 500; font-size: 0.9rem; margin-bottom: 12px; }
input, select {
  display: block;
  width: 100%;
  margin-top: 4px;
  padding: 9px 10px;
  font: inherit;
  border: 1px solid #cfd6e3;
  border-radius: 8px;
  background: #fff;
}
input:focus, select:focus { outline: 2px solid #b9d6f2; border-color: var(--brand); }

.grid-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0 16px; }
.grid-form .wide { grid-column: 1 / -1; }
.actions { display: flex; gap: 10px; flex-wrap: wrap; }

button, .button {
  display: inline-block;
  padding: 9px 18px;
  font: inherit;
  font-weight: 600;
  color: #fff;
  background: var(--brand);
  border: 0;
  border-radius: 8px;
  cursor: pointer;
  text-decoration: none;
}
button:hover, .button:hover { background: var(--brand-dark); }
button.danger { background: var(--danger); }

.details { display: grid; grid-template-columns: max-content 1fr; gap: 6px 24px; margin: 0; }
.details dt { color: var(--muted); }
.details dd { margin: 0; font-weight: 500; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-top: 8px; }
.stat { border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; }
.stat .label { color: var(--muted); font-size: 0.8rem; }
.stat .value { font-size: 1.4rem; font-weight: 700; }

.message { padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; }
.message.error { background: #fde8e8; color: #9b1c1c; }
.message.success { background: #e7f6ee; color: #146c43; }

footer { text-align: center; color: var(--muted); font-size: 0.8rem; padding: 24px 16px 40px; }
