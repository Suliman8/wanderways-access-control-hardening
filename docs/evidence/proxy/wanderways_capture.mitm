,7:headers;204:42:6:Server,29:Werkzeug/3.1.9 Python/3.13.12,]40:4:Date,29:Sat, 21 Nov 2026 01:44:04 GMT,]36:12:Content-Type,16:application/json,]24:14:Content-Length,3:401,]16:4:Vary,6:Cookie,]22:10:Connection,5:close,]]12:http_version;8:HTTP/1.1,}7:request;547:4:path;15:/api/bookings/1,9:authority;0:,6:scheme;4:http,6:method;3:GET,4:port;4:5000#4:host;9:127.0.0.1;13:timestamp_end;17:1795225444.049338^15:timestamp_start;18:1795225444.0488591^8:trailers;0:~7:content;0:,7:headers;294:25:4:Host,14:127.0.0.1:5000,]56:10:User-Agent,38:WanderWays-traffic-generator/1.0 (lab),]36:15:Accept-Encoding,13:gzip, deflate,]15:6:Accept,3:*/*,]28:10:Connection,10:keep-alive,]109:6:Cookie,96:ww_role=admin; session=eyJ1c2VyX2lkIjoxLCJyb2xlIjoiYWRtaW4ifQ.awD3Yw.NzTBQzobZeVCMiBtLooUbrZ0n7k,]]12:http_version;8:HTTP/1.1,}6:backup;0:~17:timestamp_created;18:1795225444.0489998^7:comment;0:;8:metadata;0:}6:marked;0:;9:is_replay;0:~11:intercepted;5:false!11:server_conn;448:3:via;0:~19:timestamp_tcp_setup;18:1795225444.0504792^7:address;19:9:127.0.0.1;4:5000#]19:timestamp_tls_setup;0:~13:timestamp_end;0:~15:timestamp_start;17:1795225444.049957^3:sni;0:~11:tls_version;0:~11:cipher_list;0:]6:cipher;0:~11:alpn_offers;0:]4:alpn;0:~16:certificate_list;0:]3:tls;5:false!5:error;0:~18:transport_protocol;3:tcp;2:id;36:9a6955f4-a368-4692-b365-ae013e90eb4f;8:sockname;20:9:127.0.0.1;5:39480#]8:peername;19:9:127.0.0.1;4:5000#]}11:client_conn;399:10:proxy_mode;7:regular;8:mitmcert;0:~19:timestamp_tls_setup;0:~13:timestamp_end;0:~15:timestamp_start;17:1795225444.047976^3:sni;0:~11:tls_version;0:~11:cipher_list;0:]6:cipher;0:~11:alpn_offers;0:]4:alpn;0:~16:certificate_list;0:]3:tls;5:false!5:error;0:~18:transport_protocol;3:tcp;2:id;36:a00787bd-41e7-4f83-be06-39291c308d4d;8:sockname;19:9:127.0.0.1;4:8081#]8:peername;20:9:127.0.0.1;5:49898#]}5:error;0:~2:id;36:3d3fe9b0-db13-46de-8493-7e0f93d61e74;4:type;4:http;7:version;2:21#}3583:9:websocket;0:~8:response;1891:6:reason;2:OK,11:status_code;3:200#13:timestamp_end;18:1795225444.0629606^15:timestamp_start;18:1795225444.0623746^8:trailers;0:~7:content;1491:<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Profile · WanderWays Travel</title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body data-page="profile" data-user-id="1">
  <div class="lab-banner">Training lab · intentionally vulnerable · run on 127.0.0.1 only</div>
  <header class="topbar">
    <a class="brand" href="/">Wander<span>Ways</span> <small>Travel</small></a>
    
    <nav>
      <a href="/dashboard">Bookings</a>
      
      <a href="/profile">Profile</a>
      <a href="/admin">Admin</a>
      <span class="who">Areeba Siddiqui <span class="role role-admin">admin</span></span>
      <a id="logout-link" class="logout" href="/logout">Log out</a>
    </nav>
    
  </header>
  <main class="container">
    <div id="page-message" class="message" hidden></div>
    
<section class="card narrow">
  <h1>My profile</h1>
  <p class="muted">Username: <strong id="profile-username"></strong> · Role: <strong id="profile-role"></strong></p>
  <form id="profile-form">
    <label>Full name <input name="full_name" required></label>
    <label>Email <input type="email" name="email" required></label>
    <label>Phone <input name="phone"></label>
    <button type="submit">Save profile</button>
  </form>
</section>

  </main>
  <footer>WanderWays Travel · internal booking prototype · Ezitech</footer>
  <script src="/static/js/app.js"></script>
</body>
</html>,7:headers;213:42:6:Server,29:Werkzeug/3.1.9 Python/3.13.12,]40:4:Date,29:Sat, 21 Nov 2026 01:44:04 GMT,]44:12:Content-Type,24:text/html; charset=utf-8,]25:14:Content-Length,4:1491,]16:4:Vary,6:Cookie,]22:10:Connection,5:close,]]12:http_version;8:HTTP/1.1,}7:request;539:4:path;8:/profile,9:authority;0:,6:scheme;4:http,6:method;3:GET,4:port;4:5000#4:host;9:127.0.0.1;13:timestamp_end;18:1795225444.0582657^15:timestamp_start;17:1795225444.057709^8:trailers;0:~7:content;0:,7:headers;294:25:4:Host,14:127.0.0.1:5000,]56:10:User-Agent,38:WanderWays-traffic-generator/1.0 (lab),]36:15:Accept-Encoding,13:gzip, deflate,]15:6:Accept,3:*/*,]28:10:Connection,10:keep-alive,]109:6:Cookie,96:ww_role=admin; session=eyJ1c2VyX2lkIjoxLCJyb2xlIjoiYWRtaW4ifQ.awD3Yw.NzTBQzobZeVCMiBtLooUbrZ0n7k,]]12:http_version;8:HTTP/1.1,}6:backup;0:~17:timestamp_created;18:1795225444.0578675^7:comment;0:;8:metadata;0:}6:marked;0:;9:is_replay;0:~11:intercepted;5:false!11:server_conn;449:3:via;0:~19:timestamp_tcp_setup;18:1795225444.0595803^7:address;19:9:127.0.0.1;4:5000#]19:timestamp_tls_setup;0:~13:timestamp_end;0:~15:timestamp_start;18:1795225444.0591545^3:sni;0:~11:tls_version;0:~11:cipher_list;0:]6:cipher;0:~11:alpn_offers;0:]4:alpn;0:~16:certificate_list;0:]3:tls;5:false!5:error;0:~18:transport_protocol;3:tcp;2:id;36:e4d677af-8d0b-414b-8925-6dc707ef1f4b;8:sockname;20:9:127.0.0.1;5:39488#]8:peername;19:9:127.0.0.1;4:5000#]}11:client_conn;400:10:proxy_mode;7:regular;8:mitmcert;0:~19:timestamp_tls_setup;0:~13:timestamp_end;0:~15:timestamp_start;18:1795225444.0564625^3:sni;0:~11:tls_version;0:~11:cipher_list;0:]6:cipher;0:~11:alpn_offers;0:]4:alpn;0:~16:certificate_list;0:]3:tls;5:false!5:error;0:~18:transport_protocol;3:tcp;2:id;36:937f1588-d686-4085-9cb3-0f16e87a181f;8:sockname;19:9:127.0.0.1;4:8081#]8:peername;20:9:127.0.0.1;5:49902#]}5:error;0:~2:id;36:a413560f-97fa-468a-a573-178748c3cd90;4:type;4:http;7:version;2:21#}6733:9:websocket;0:~8:response;5028:6:reason;2:OK,11:status_code;3:200#13:timestamp_end;17:1795225444.070902^15:timestamp_start;18:1795225444.0704195^8:trailers;0:~7:content;4363::root {
  --bg: #f4f6fa;
  --surface: #ffffff;
  --text: #1c2433;
  --muted: #667085;
  --line: #e3e7ef;
  --brand: #0f6cbd;
  --brand-dark: #0b4f8a;
  --danger: #c0392b;
  --ok: #1e8e5a;
  --warn: #b7791f;
  --radius: 10px;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
}

a { color: var(--brand); }

.lab-banner {
  background: #fff4e5;
  color: #8a5300;
  font-size: 0.8rem;
  text-align: center;
  padding: 4px 16px;
  border-bottom: 1px solid #f5d9a8;
}

.topbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 24px;
  background: var(--surface);
  border-bottom: 1px solid var(--line);
}

.brand { font-size: 1.3rem; font-weight: 700; color: var(--text); text-decoration: none; }
.brand span { color: var(--brand); }
.brand small { font-weight: 500; color: var(--muted); font-size: 0.85rem; }

nav { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
nav a { text-decoration: none; font-weight: 500; }
nav .who { color: var(--muted); font-size: 0.9rem; }

.role {
  display: inline-block;
  padding: 1px 8px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.role-admin { background: #fde8e8; color: #9b1c1c; }
.role-agent { background: #e6f0fb; color: var(--brand-dark); }
.role-customer { background: #e7f6ee; color: #146c43; }

.container { max-width: 1080px; margin: 24px auto; padding: 0 16px; }

.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 20px 24px;
  margin-bottom: 20px;
}
.card.narrow { max-width: 440px; margin: 40px auto; }
.card-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }

h1 { font-size: 1.4rem; margin: 0 0 12px; }
h2 { font-size: 1.1rem; margin: 0 0 12px; }
.muted { color: var(--muted); }

.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
th { color: var(--muted); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }
tbody tr:hover { background: #f8fafd; }

.badge { padding: 2px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; }
.badge-confirmed { background: #e7f6ee; color: var(--ok); }
.badge-pending { background: #fdf3e1; color: var(--warn); }
.badge-cancelled { background: #fde8e8; color: var(--danger); }

form label { display: block; font-weight: 500; font-size: 0.9rem; margin-bottom: 12px; }
input, select {
  display: block;
  width: 100%;
  margin-top: 4px;
  padding: 9px 10px;
  font: inherit;
  border: 1px solid #cfd6e3;
  border-radius: 8px;
  background: #fff;
}
input:focus, select:focus { outline: 2px solid #b9d6f2; border-color: var(--brand); }

.grid-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0 16px; }
.grid-form .wide { grid-column: 1 / -1; }
.actions { display: flex; gap: 10px; flex-wrap: wrap; }

button, .button {
  display: inline-block;
  padding: 9px 18px;
  font: inherit;
  font-weight: 600;
  color: #fff;
  background: var(--brand);
  border: 0;
  border-radius: 8px;
  cursor: pointer;
  text-decoration: none;
}
button:hover, .button:hover { background: var(--brand-dark); }
button.danger { background: var(--danger); }

.details { display: grid; grid-template-columns: max-content 1fr; gap: 6px 24px; margin: 0; }
.details dt { color: var(--muted); }
.details dd { margin: 0; font-weight: 500; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-top: 8px; }
.stat { border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; }
.stat .label { color: var(--muted); font-size: 0.8rem; }
.stat .value { font-size: 1.4rem; font-weight: 700; }

.message { padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; }
.message.error { background: #fde8e8; color: #9b1c1c; }
.message.success { background: #e7f6ee; color: #146c43; }

footer { text-align: center; color: var(--muted); font-size: 0.8rem; padding: 24px 16px 40px; }
,7:headers;479:42:6:Server,29:Werkzeug/3.1.9 Python/3.13.12,]40:4:Date,29:Sat, 21 Nov 2026 01:44:04 GMT,]53:19:Content-Disposition,26:inline; filename=style.css,]43:12:Content-Type,23:text/css; charset=utf-8,]25:14:Content-Length,4:4363,]50:13:Last-Modified,29:Sat, 21 Nov 2026 01:32:58 GMT,]28:13:Cache-Control,8:no-cache,]47:4:ETag,36:"1795224778.1170447-4363-2137138140",]40:4:Date,29:Sat, 21 Nov 2026 01:44:04 GMT,]25:13:Accept-Ranges,5:bytes,]16:4:Vary,6:Cookie,]22:10:Connection,5:close,]]12:http_version;8:HTTP/1.1,}7:request;553:4:path;21:/static/css/style.css,9:authority;0:,6:scheme;4:http,6:method;3:GET,4:port;4:5000#4:host;9:127.0.0.1;13:timestamp_end;17:1795225444.066734^15:timestamp_start;18:1795225444.0663152^8:trailers;0:~7:content;0:,7:headers;294:25:4:Host,14:127.0.0.1:5000,]56:10:User-Agent,38:WanderWays-traffic-generator/1.0 (lab),]36:15:Accept-Encoding,13:gzip, deflate,]15:6:Accept,3:*/*,]28:10:Connection,10:keep-alive,]109:6:Cookie,96:ww_role=admin; session=eyJ1c2VyX2lkIjoxLCJyb2xlIjoiYWRtaW4ifQ.awD3Yw.NzTBQzobZeVCMiBtLooUbrZ0n7k,]]12:http_version;8:HTTP/1.1,}6:backup;0:~17:timestamp_created;17:1795225444.066435^7:comment;0:;8:metadata;0:}6:marked;0:;9:is_replay;0:~11:intercepted;5:false!11:server_conn;449:3:via;0:~19:timestamp_tcp_setup;18:1795225444.0678082^7:address;19:9:127.0.0.1;4:5000#]19:timestamp_tls_setup;0:~13:timestamp_end;0:~15:timestamp_start;18:1795225444.0673628^3:sni;0:~11:tls_version;0:~11:cipher_list;0:]6:cipher;0:~11:alpn_offers;0:]4:alpn;0:~16:certificate_list;0:]3:tls;5:false!5:error;0:~18:transport_protocol;3:tcp;2:id;36:c284171e-fb2a-428e-bb77-5c8ead6d9645;8:sockname;20:9:127.0.0.1;5:39496#]8:peername;19:9:127.0.0.1;4:5000#]}11:client_conn;400:10:proxy_mode;7:regular;8:mitmcert;0:~19:timestamp_tls_setup;0:~13:timestamp_end;0:~15:timestamp_start;18:1795225444.0653598^3:sni;0:~11:tls_version;0:~11:cipher_list;0:]6:cipher;0:~11:alpn_offers;0:]4:alpn;0:~16:certificate_list;0:]3:tls;5:false!5:error;0:~18:transport_protocol;3:tcp;2:id;36:b38e69d5-384d-4a15-a539-9cfaa0bdfb5b;8:sockname;19:9:127.0.0.1;4:8081#]8:peername;20:9:127.0.0.1;5:49904#]}5:error;0:~2:id;36:cc07fd62-deb8-4e2a-8760-388c0a4fa51e;4:type;4:http;7:version;2:21#}11275:9:websocket;0:~8:response;9572:6:reason;2:OK,11:status_code;3:200#13:timestamp_end;18:1795225444.0798316^15:timestamp_start;17:1795225444.079068^8:trailers;0:~7:content;8903:/* WanderWays front-end: every page loads its data from the JSON API. */
"use strict";

// NOTE(dev): the old mobile app still reads /api/v1/bookings (no login needed).
// Remove it once the v2 migration is finished - ticket WW-142.

async function api(path, options = {}) {
  const opts = { credentials: "same-origin", headers: {}, ...options };
  if (opts.body !== undefined && typeof opts.body !== "string") {
    opts.headers["Content-Type"] = "application/json";
    opts.body = JSON.stringify(opts.body);
  }
  const res = await fetch(path, opts);
  const isJson = (res.headers.get("Content-Type") || "").includes("application/json");
  const data = isJson ? await res.json() : await res.text();
  if (!res.ok) {
    throw new Error((data && data.error) || `Request failed (HTTP ${res.status})`);
  }
  return data;
}

/* Small DOM helper: strings become text nodes, so API data is never parsed as HTML. */
function el(tag, attrs = {}, ...children) {
  const node = document.createElement(tag);
  for (const [key, value] of Object.entries(attrs)) {
    node.setAttribute(key, value);
  }
  for (const child of children) {
    node.append(child instanceof Node ? child : document.createTextNode(String(child ?? "")));
  }
  return node;
}

const money = (v) =>
  "$" + Number(v).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const badge = (status) => el("span", { class: `badge badge-${status}` }, status);

function showMessage(text, kind = "error") {
  const box = document.getElementById("page-message");
  if (!box) return;
  box.className = `message ${kind}`;
  box.textContent = text;
  box.hidden = false;
}

function formValues(form) {
  return Object.fromEntries(new FormData(form).entries());
}

const pages = {
  async login() {
    const form = document.getElementById("login-form");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      try {
        await api("/api/auth/login", { method: "POST", body: formValues(form) });
        const next = new URLSearchParams(location.search).get("next");
        location.href = next && next.startsWith("/") && !next.startsWith("//") ? next : "/dashboard";
      } catch (err) {
        showMessage(err.message);
      }
    });
  },

  async dashboard() {
    const data = await api("/api/bookings");
    document.getElementById("booking-count").textContent = `${data.count} booking(s)`;
    const body = document.getElementById("bookings-body");
    body.replaceChildren();
    if (data.count === 0) {
      body.append(el("tr", {}, el("td", { colspan: 7, class: "muted" }, "No bookings yet.")));
      return;
    }
    for (const b of data.bookings) {
      body.append(
        el("tr", {},
          el("td", {}, el("a", { href: `/bookings/${b.id}` }, b.booking_ref)),
          el("td", {}, b.customer_name),
          el("td", {}, b.destination),
          el("td", {}, `${b.depart_date} → ${b.return_date}`),
          el("td", {}, b.travellers),
          el("td", {}, money(b.total_price)),
          el("td", {}, badge(b.status)),
        ),
      );
    }
  },

  async bookingDetail() {
    const id = document.body.dataset.bookingId;
    const form = document.getElementById("booking-edit-form");

    const render = (b) => {
      document.getElementById("booking-title").textContent = `Booking ${b.booking_ref}`;
      document.getElementById("booking-status").replaceChildren(badge(b.status));
      const rows = [
        ["Customer", b.customer_name],
        ["Agent", b.agent_name || "Not assigned"],
        ["Destination", b.destination],
        ["Hotel", b.hotel],
        ["Dates", `${b.depart_date} → ${b.return_date}`],
        ["Travellers", b.travellers],
        ["Total price", money(b.total_price)],
        ["Passport no.", b.passport_no],
        ["Card", `•••• ${b.payment_last4}`],
        ["Notes", b.notes || "-"],
      ];
      document.getElementById("booking-details").replaceChildren(
        ...rows.flatMap(([label, value]) => [el("dt", {}, label), el("dd", {}, value)]),
      );
      form.depart_date.value = b.depart_date;
      form.return_date.value = b.return_date;
      form.travellers.value = b.travellers;
      form.notes.value = b.notes;
    };

    render(await api(`/api/bookings/${id}`));

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const values = formValues(form);
      values.travellers = Number(values.travellers);
      try {
        render(await api(`/api/bookings/${id}`, { method: "PUT", body: values }));
        showMessage("Booking updated.", "success");
      } catch (err) {
        showMessage(err.message);
      }
    });

    document.getElementById("cancel-booking").addEventListener("click", async () => {
      if (!confirm("Cancel this booking?")) return;
      try {
        render(await api(`/api/bookings/${id}/cancel`, { method: "POST" }));
        showMessage("Booking cancelled.", "success");
      } catch (err) {
        showMessage(err.message);
      }
    });
  },

  async bookingNew() {
    const [destinations, agents] = await Promise.all([api("/api/destinations"), api("/api/agents")]);
    const destSelect = document.getElementById("destination");
    const hotelSelect = document.getElementById("hotel");
    const agentSelect = document.getElementById("agent");

    destSelect.replaceChildren(
      ...destinations.map((d) => el("option", { value: d.name }, `${d.name} - ${money(d.price_per_traveller)} pp`)),
    );
    const fillHotels = () => {
      const chosen = destinations.find((d) => d.name === destSelect.value);
      hotelSelect.replaceChildren(...chosen.hotels.map((h) => el("option", { value: h }, h)));
    };
    destSelect.addEventListener("change", fillHotels);
    fillHotels();
    agentSelect.append(...agents.map((a) => el("option", { value: a.id }, a.full_name)));

    const form = document.getElementById("booking-new-form");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const values = formValues(form);
      values.travellers = Number(values.travellers);
      values.agent_id = values.agent_id ? Number(values.agent_id) : null;
      try {
        const booking = await api("/api/bookings", { method: "POST", body: values });
        location.href = `/bookings/${booking.id}`;
      } catch (err) {
        showMessage(err.message);
      }
    });
  },

  async profile() {
    const id = document.body.dataset.userId;
    const form = document.getElementById("profile-form");
    const render = (u) => {
      document.getElementById("profile-username").textContent = u.username;
      document.getElementById("profile-role").textContent = u.role;
      form.full_name.value = u.full_name;
      form.email.value = u.email;
      form.phone.value = u.phone || "";
    };

    render(await api(`/api/users/${id}`));

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      try {
        render(await api(`/api/users/${id}`, { method: "PATCH", body: formValues(form) }));
        showMessage("Profile saved.", "success");
      } catch (err) {
        showMessage(err.message);
      }
    });
  },

  async admin() {
    const statsBox = document.getElementById("stats");
    try {
      const s = await api("/api/admin/stats");
      const tiles = [
        ["Total bookings", s.total_bookings],
        ["Confirmed", s.bookings_by_status.confirmed || 0],
        ["Pending", s.bookings_by_status.pending || 0],
        ["Cancelled", s.bookings_by_status.cancelled || 0],
        ["Confirmed revenue", money(s.confirmed_revenue_usd)],
      ];
      statsBox.replaceChildren(
        ...tiles.map(([label, value]) => el("div", { class: "stat" }, el("div", { class: "label" }, label), el("div", { class: "value" }, value))),
      );
    } catch (err) {
      statsBox.replaceChildren(el("p", { class: "muted" }, `Statistics unavailable: ${err.message}`));
    }

    const data = await api("/api/admin/users");
    document.getElementById("users-body").replaceChildren(
      ...data.users.map((u) =>
        el("tr", {},
          el("td", {}, u.id),
          el("td", {}, u.username),
          el("td", {}, u.full_name),
          el("td", {}, u.email),
          el("td", {}, u.phone || "-"),
          el("td", {}, el("span", { class: `role role-${u.role}` }, u.role)),
        ),
      ),
    );
  },
};

document.addEventListener("DOMContentLoaded", () => {
  const logout = document.getElementById("logout-link");
  if (logout) {
    logout.addEventListener("click", async (event) => {
      event.preventDefault();
      try {
        await api("/api/auth/logout", { method: "POST" });
      } finally {
        location.href = "/login";
      }
    });
  }

  const page = pages[document.body.dataset.page];
  if (page) {
    page().catch((err) => showMessage(err.message));
  }
});
