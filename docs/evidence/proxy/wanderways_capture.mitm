,7:headers;204:42:6:Server,29:Werkzeug/3.1.9 Python/3.13.12,]40:4:Date,29:Sat, 21 Nov 2026 01:44:03 GMT,]36:12:Content-Type,16:application/json,]24:14:Content-Length,3:401,]16:4:Vary,6:Cookie,]22:10:Connection,5:close,]]12:http_version;8:HTTP/1.1,}7:request;555:4:path;15:/api/bookings/1,9:authority;0:,6:scheme;4:http,6:method;3:GET,4:port;4:5000#4:host;9:127.0.0.1;13:timestamp_end;18:1795225443.3151767^15:timestamp_start;17:1795225443.314339^8:trailers;0:~7:content;0:,7:headers;302:25:4:Host,14:127.0.0.1:5000,]56:10:User-Agent,38:WanderWays-traffic-generator/1.0 (lab),]36:15:Accept-Encoding,13:gzip, deflate,]15:6:Accept,3:*/*,]28:10:Connection,10:keep-alive,]117:6:Cookie,103:ww_role=customer; session=eyJ1c2VyX2lkIjo0LCJyb2xlIjoiY3VzdG9tZXIifQ.awD3Yw.OPg96EV1mLv1YXiGQ3mhz1JfrBk,]]12:http_version;8:HTTP/1.1,}6:backup;0:~17:timestamp_created;18:1795225443.3145907^7:comment;0:;8:metadata;0:}6:marked;0:;9:is_replay;0:~11:intercepted;5:false!11:server_conn;448:3:via;0:~19:timestamp_tcp_setup;17:1795225443.317103^7:address;19:9:127.0.0.1;4:5000#]19:timestamp_tls_setup;0:~13:timestamp_end;0:~15:timestamp_start;18:1795225443.3161867^3:sni;0:~11:tls_version;0:~11:cipher_list;0:]6:cipher;0:~11:alpn_offers;0:]4:alpn;0:~16:certificate_list;0:]3:tls;5:false!5:error;0:~18:transport_protocol;3:tcp;2:id;36:7c1f4fae-7898-433e-af1e-206fc42f4724;8:sockname;20:9:127.0.0.1;5:39026#]8:peername;19:9:127.0.0.1;4:5000#]}11:client_conn;400:10:proxy_mode;7:regular;8:mitmcert;0:~19:timestamp_tls_setup;0:~13:timestamp_end;0:~15:timestamp_start;18:1795225443.3130946^3:sni;0:~11:tls_version;0:~11:cipher_list;0:]6:cipher;0:~11:alpn_offers;0:]4:alpn;0:~16:certificate_list;0:]3:tls;5:false!5:error;0:~18:transport_protocol;3:tcp;2:id;36:4a6ece95-19f2-4ad1-97c4-b3bdbdde0beb;8:sockname;19:9:127.0.0.1;4:8081#]8:peername;20:9:127.0.0.1;5:49518#]}5:error;0:~2:id;36:309093b1-6143-4ea5-98a0-e605dfffe437;4:type;4:http;7:version;2:21#}3604:9:websocket;0:~8:response;1905:6:reason;2:OK,11:status_code;3:200#13:timestamp_end;17:1795225443.328557^15:timestamp_start;18:1795225443.3280466^8:trailers;0:~7:content;1506:<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Profile · WanderWays Travel</title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body data-page="profile" data-user-id="4">
  <div class="lab-banner">Training lab · intentionally vulnerable · run on 127.0.0.1 only</div>
  <header class="topbar">
    <a class="brand" href="/">Wander<span>Ways</span> <small>Travel</small></a>
    
    <nav>
      <a href="/dashboard">Bookings</a>
      <a href="/bookings/new">New booking</a>
      <a href="/profile">Profile</a>
      
      <span class="who">Ayesha Khan <span class="role role-customer">customer</span></span>
      <a id="logout-link" class="logout" href="/logout">Log out</a>
    </nav>
    
  </header>
  <main class="container">
    <div id="page-message" class="message" hidden></div>
    
<section class="card narrow">
  <h1>My profile</h1>
  <p class="muted">Username: <strong id="profile-username"></strong> · Role: <strong id="profile-role"></strong></p>
  <form id="profile-form">
    <label>Full name <input name="full_name" required></label>
    <label>Email <input type="email" name="email" required></label>
    <label>Phone <input name="phone"></label>
    <button type="submit">Save profile</button>
  </form>
</section>

  </main>
  <footer>WanderWays Travel · internal booking prototype · Ezitech</footer>
  <script src="/static/js/app.js"></script>
</body>
