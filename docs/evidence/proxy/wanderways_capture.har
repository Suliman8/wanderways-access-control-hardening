                        "mimeType": "text/html; charset=utf-8",
                        "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Admin \u00b7 WanderWays Travel</title>\n  <link rel=\"stylesheet\" href=\"/static/css/style.css\">\n</head>\n<body data-page=\"admin\" data-user-id=\"1\">\n  <div class=\"lab-banner\">Training lab \u00b7 intentionally vulnerable \u00b7 run on 127.0.0.1 only</div>\n  <header class=\"topbar\">\n    <a class=\"brand\" href=\"/\">Wander<span>Ways</span> <small>Travel</small></a>\n    \n    <nav>\n      <a href=\"/dashboard\">Bookings</a>\n      \n      <a href=\"/profile\">Profile</a>\n      <a href=\"/admin\">Admin</a>\n      <span class=\"who\">Areeba Siddiqui <span class=\"role role-admin\">admin</span></span>\n      <a id=\"logout-link\" class=\"logout\" href=\"/logout\">Log out</a>\n    </nav>\n    \n  </header>\n  <main class=\"container\">\n    <div id=\"page-message\" class=\"message\" hidden></div>\n    \n<section class=\"card\">\n  <div class=\"card-head\">\n    <h1>Admin panel</h1>\n    <a class=\"button\" href=\"/api/admin/bookings/export\">Export bookings (CSV)</a>\n  </div>\n  <div id=\"stats\" class=\"stats\"></div>\n</section>\n\n<section class=\"card\">\n  <h2>User accounts</h2>\n  <div class=\"table-wrap\">\n    <table>\n      <thead><tr><th>ID</th><th>Username</th><th>Name</th><th>Email</th><th>Phone</th><th>Role</th></tr></thead>\n      <tbody id=\"users-body\"><tr><td colspan=\"6\" class=\"muted\">Loading\u2026</td></tr></tbody>\n    </table>\n  </div>\n</section>\n\n  </main>\n  <footer>WanderWays Travel \u00b7 internal booking prototype \u00b7 Ezitech</footer>\n  <script src=\"/static/js/app.js\"></script>\n</body>\n</html>"
