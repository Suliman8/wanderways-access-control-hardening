                        "compression": 0,
                        "mimeType": "text/html; charset=utf-8",
                        "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>New booking \u00b7 WanderWays Travel</title>\n  <link rel=\"stylesheet\" href=\"/static/css/style.css\">\n</head>\n<body data-page=\"bookingNew\" data-user-id=\"4\">\n  <div class=\"lab-banner\">Training lab \u00b7 intentionally vulnerable \u00b7 run on 127.0.0.1 only</div>\n  <header class=\"topbar\">\n    <a class=\"brand\" href=\"/\">Wander<span>Ways</span> <small>Travel</small></a>\n    \n    <nav>\n      <a href=\"/dashboard\">Bookings</a>\n      <a href=\"/bookings/new\">New booking</a>\n      <a href=\"/profile\">Profile</a>\n      \n      <span class=\"who\">Ayesha Khan <span class=\"role role-customer\">customer</span></span>\n      <a id=\"logout-link\" class=\"logout\" href=\"/logout\">Log out</a>\n    </nav>\n    \n  </header>\n  <main class=\"container\">\n    <div id=\"page-message\" class=\"message\" hidden></div>\n    \n<section class=\"card\">\n  <h1>New booking</h1>\n  <form id=\"booking-new-form\" class=\"grid-form\">\n    <label class=\"wide\">Destination <select name=\"destination\" id=\"destination\" required></select></label>\n    <label class=\"wide\">Hotel <select name=\"hotel\" id=\"hotel\"></select></label>\n    <label>Departure <input type=\"date\" name=\"depart_date\" required></label>\n    <label>Return <input type=\"date\" name=\"return_date\" required></label>\n    <label>Travellers <input type=\"number\" name=\"travellers\" min=\"1\" max=\"9\" value=\"1\" required></label>\n    <label>Preferred agent <select name=\"agent_id\" id=\"agent\"><option value=\"\">No preference</option></select></label>\n    <label class=\"wide\">Notes <input name=\"notes\" maxlength=\"200\"></label>\n    <div class=\"actions wide\"><button type=\"submit\">Request booking</button></div>\n  </form>\n</section>\n\n  </main>\n  <footer>WanderWays Travel \u00b7 internal booking prototype \u00b7 Ezitech</footer>\n  <script src=\"/static/js/app.js\"></script>\n</body>\n</html>"
                    },
