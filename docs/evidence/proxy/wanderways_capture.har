                        "mimeType": "text/html; charset=utf-8",
                        "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Sign in \u00b7 WanderWays Travel</title>\n  <link rel=\"stylesheet\" href=\"/static/css/style.css\">\n</head>\n<body data-page=\"login\" data-user-id=\"\">\n  <div class=\"lab-banner\">Training lab \u00b7 intentionally vulnerable \u00b7 run on 127.0.0.1 only</div>\n  <header class=\"topbar\">\n    <a class=\"brand\" href=\"/\">Wander<span>Ways</span> <small>Travel</small></a>\n    \n  </header>\n  <main class=\"container\">\n    <div id=\"page-message\" class=\"message\" hidden></div>\n    \n<section class=\"card narrow\">\n  <h1>Sign in</h1>\n  <p class=\"muted\">Use one of the demo accounts listed in the project README.</p>\n  \n  <form id=\"login-form\" method=\"post\" action=\"/login?next=\">\n    <label>Username <input name=\"username\" autocomplete=\"username\" required autofocus></label>\n    <label>Password <input name=\"password\" type=\"password\" autocomplete=\"current-password\" required></label>\n    <button type=\"submit\">Sign in</button>\n  </form>\n</section>\n\n  </main>\n  <footer>WanderWays Travel \u00b7 internal booking prototype \u00b7 Ezitech</footer>\n  <script src=\"/static/js/app.js\"></script>\n</body>\n</html>"
