st4\":\"7375\",\"notes\":\"Vegetarian meals\",\"created_at\":\"2026-11-12 09:26:00\"},{\"id\":14,\"booking_ref\":\"WW-26-1014\",\"customer_id\":5,\"customer_name\":\"Omar Farooq\",\"agent_id\":2,\"agent_name\":\"Sara Malik\",\"destination\":\"Istanbul, Turkiye\",\"hotel\":\"Old City Inn\",\"depart_date\":\"2027-02-02\",\"return_date\":\"2027-02-12\",\"travellers\":2,\"total_price\":2390.0,\"status\":\"pending\",\"passport_no\":\"ZX8697676\",\"payment_last4\":\"9801\",\"notes\":\"Window seat requested\",\"created_at\":\"2026-11-19 17:52:00\"},{\"id\":15,\"booking_ref\":\"WW-26-1015\",\"customer_id\":6,\"customer_name\":\"Hina Raza\",\"agent_id\":2,\"agent_name\":\"Sara Malik\",\"destination\":\"Istanbul, Turkiye\",\"hotel\":\"Old City Inn\",\"depart_date\":\"2027-02-09\",\"return_date\":\"2027-02-18\",\"travellers\":1,\"total_price\":1575.0,\"status\":\"pending\",\"passport_no\":\"ZX4162996\",\"payment_last4\":\"7927\",\"notes\":\"Late check-out requested\",\"created_at\":\"2026-11-06 09:46:00\"},{\"id\":16,\"booking_ref\":\"WW-26-1016\",\"customer_id\":7,\"customer_name\":\"Usman Tariq\",\"agent_id\":3,\"agent_name\":\"Bilal Ahmed\",\"destination\":\"Dubai, UAE\",\"hotel\":\"Creekside Grand\",\"depart_date\":\"2026-12-17\",\"return_date\":\"2026-12-23\",\"travellers\":2,\"total_price\":1870.0,\"status\":\"confirmed\",\"passport_no\":\"ZX2319675\",\"payment_last4\":\"6278\",\"notes\":\"Vegetarian meals\",\"created_at\":\"2026-11-06 15:39:00\"},{\"id\":17,\"booking_ref\":\"WW-26-1017\",\"customer_id\":4,\"customer_name\":\"Ayesha Khan\",\"agent_id\":3,\"agent_name\":\"Bilal Ahmed\",\"destination\":\"Baku, Azerbaijan\",\"hotel\":\"Flame Towers Residence\",\"depart_date\":\"2027-01-14\",\"return_date\":\"2027-01-19\",\"travellers\":3,\"total_price\":2420.0,\"status\":\"confirmed\",\"passport_no\":\"ZX9712997\",\"payment_last4\":\"7897\",\"notes\":\"Airport pickup needed\",\"created_at\":\"2026-11-16 16:05:00\"},{\"id\":18,\"booking_ref\":\"WW-26-1018\",\"customer_id\":5