                        "text": "{\"count\":21,\"bookings\":[{\"id\":1,\"booking_ref\":\"WW-26-1001\",\"customer_id\":4,\"customer_name\":\"Ayesha Khan\",\"agent_id\":3,\"agent_name\":\"Bilal Ahmed\",\"destination\":\"Istanbul, Turkiye\",\"hotel\":\"Old City Inn\",\"depart_date\":\"2027-01-10\",\"return_date\":\"2027-01-14\",\"travellers\":2,\"total_price\":2080.0,\"status\":\"confirmed\",\"passport_no\":\"ZX2354318\",\"payment_last4\":\"1814\",\"notes\":\"Vegetarian meals\",\"created_at\":\"2026-11-19 18:20:00\"},{\"id\":2,\"booking_ref\":\"WW-26-1002\",\"customer_id\":5,\"customer_name\":\"Omar Farooq\",\"agent_id\":3,\"agent_name\":\"Bilal Ahmed\",\"destination\":\"Istanbul, Turkiye\",\"hotel\":\"Old City Inn\",\"depart_date\":\"2027-01-27\",\"return_date\":\"2027-01-30\",\"travellers\":4,\"total_price\":3240.0,\"status\":\"cancelled\",\"passport_no\":\"ZX6983360\",\"payment_last4\":\"6166\",\"notes\":\"Late check-out requested\",\"created_at\":\"2026-11-07 15:46:00\"},{\"id\":3,\"booking_ref\":\"WW-26-1003\",\"customer_id\":6,\"customer_name\":\"Hina Raza\",\"agent_id\":3,\"agent_name\":\"Bilal Ahmed\",\"destination\":\"Tbilisi, Georgia\",\"hotel\":\"Rustaveli Plaza\",\"depart_date\":\"2027-02-20\",\"return_date\":\"2027-02-24\",\"travellers\":3,\"total_price\":2050.0,\"status\":\"confirmed\",\"passport_no\":\"ZX6184138\",\"payment_last4\":\"0405\",\"notes\":\"Travelling with an infant\",\"created_at\":\"2026-11-18 18:10:00\"},{\"id\":4,\"booking_ref\":\"WW-26-1004\",\"customer_id\":7,\"customer_name\":\"Usman Tariq\",\"agent_id\":3,\"agent_name\":\"Bilal Ahmed\",\"destination\":\"Skardu, Pakistan\",\"hotel\":\"Shangrila Lakeside\",\"depart_date\":\"2027-01-16\",\"return_date\":\"2027-01-26\",\"travellers\":4,\"total_price\":1820.0,\"status\":\"confirmed\",\"passport_no\":\"ZX9238128\",\"payment_last4\":\"6523\",\"notes\":\"Honeymoon package\",\"created_at\":\"2026-11-13 18:59:00\"},{\"id\":5,\"booking_ref\":\"WW-26-1005\",\"customer_id\":4,\"customer_name\":\"A