                        "text": "{\"count\":10,\"bookings\":[{\"id\":5,\"booking_ref\":\"WW-26-1005\",\"customer_id\":4,\"customer_name\":\"Ayesha Khan\",\"agent_id\":2,\"agent_name\":\"Sara Malik\",\"destination\":\"Hunza Valley, Pakistan\",\"hotel\":\"Karimabad Heights\",\"depart_date\":\"2027-03-19\",\"return_date\":\"2027-03-28\",\"travellers\":4,\"total_price\":1830.0,\"status\":\"cancelled\",\"passport_no\":\"ZX9778116\",\"payment_last4\":\"1680\",\"notes\":\"Late check-out requested\",\"created_at\":\"2026-11-19 12:49:00\"},{\"id\":9,\"booking_ref\":\"WW-26-1009\",\"customer_id\":4,\"customer_name\":\"Ayesha Khan\",\"agent_id\":2,\"agent_name\":\"Sara Malik\",\"destination\":\"Istanbul, Turkiye\",\"hotel\":\"Old City Inn\",\"depart_date\":\"2027-01-26\",\"return_date\":\"2027-02-02\",\"travellers\":4,\"total_price\":3545.0,\"status\":\"cancelled\",\"passport_no\":\"ZX7209730\",\"payment_last4\":\"1583\",\"notes\":\"Window seat requested\",\"created_at\":\"2026-11-14 17:10:00\"},{\"id\":10,\"booking_ref\":\"WW-26-1010\",\"customer_id\":5,\"customer_name\":\"Omar Farooq\",\"agent_id\":2,\"agent_name\":\"Sara Malik\",\"destination\":\"Bangkok, Thailand\",\"hotel\":\"Riverside Orchid\",\"depart_date\":\"2026-12-19\",\"return_date\":\"2026-12-29\",\"travellers\":1,\"total_price\":1460.0,\"status\":\"confirmed\",\"passport_no\":\"ZX1749254\",\"payment_last4\":\"8953\",\"notes\":\"Vegetarian meals\",\"created_at\":\"2026-11-01 16:42:00\"},{\"id\":11,\"booking_ref\":\"WW-26-1011\",\"customer_id\":6,\"customer_name\":\"Hina Raza\",\"agent_id\":2,\"agent_name\":\"Sara Malik\",\"destination\":\"Skardu, Pakistan\",\"hotel\":\"Deosai Base Camp\",\"depart_date\":\"2026-12-20\",\"return_date\":\"2026-12-23\",\"travellers\":3,\"total_price\":1320.0,\"status\":\"confirmed\",\"passport_no\":\"ZX9467819\",\"payment_last4\":\"4762\",\"notes\":\"\",\"created_at\":\"2026-11-05 18:18:00\"},{\"id\":13,\"booking_ref\":\"WW-26-1013\",\"customer_id\":4,\"customer_name\":\"Ayesha Khan\",\"agent_id\":2,\"agent_name\":\"Sara Malik\",\"destination\":\"Istanbul, Turkiye\",\"hotel\":\"Old City Inn\",\"depart_date\":\"2027-01-19\",\"return_date\":\"2027-01-23\",\"travellers\":1,\"total_price\":1200.0,\"status\":\"confirmed\",\"passport_no\":\"ZX6094766\",\"payment_last4\":\"7375\",\"notes\":\"Vegetarian meals\",\"created_at\":\"2026-11-12 09:26:00\"},{\"id\":14,\"booking_ref\":\"WW-26-1014\",\"customer_id\":5,\"customer_name\":\"Omar Farooq\",\"agent_id\":2,\"agent_name\":\"Sara Malik\",\"destination\":\"Istanbul, Turkiye\",\"hotel\":\"Old City Inn\",\"depart_date\":\"2027-02-02\",\"return_date\":\"2027-02-12\",\"travellers\":2,\"total_price\":2390.0,\"status\":\"pending\",\"passport_no\":\"ZX8697676\",\"payment_last4\":\"9801\",\"notes\":\"Window seat requested\",\"created_at\":\"2026-11-19 17:52:00\"},{\"id\":15,\"booking_ref\":\"WW-26-1015\",\"customer_id\":6,\"customer_name\":\"Hina Raza\",\"agent_id\":2,\"agent_name\":\"Sara Malik\",\"destination\":\"Istanbul, Turkiye\",\"hotel\":\"Old City Inn\",\"depart_date\":\"2027-02-09\",\"return_date\":\"2027-02-18\",\"travellers\":1,\"total_price\":1575.0,\"status\":\"pending\",\"passport_no\":\"ZX4162996\",\"payment_last4\":\"7927\",\"notes\":\"Late check-out requested\",\"created_at\":\"2026-11-06 09:46:00\"},{\"id\":18,\"booking_ref\":\"WW-26-1018\",\"customer_id\":5,\"customer_name\":\"Omar Farooq\",\"agent_id\":2,\"agent_name\":\"Sara Malik\",\"destination\":\"Istanbul, Turkiye\",\"hotel\":\"Old City Inn\",\"depart_date\":\"2027-02-06\",\"return_date\":\"2027-02-13\",\"travellers\":1,\"total_price\":1385.0,\"status\":\"pending\",\"passport_no\":\"ZX7845145\",\"payment_last4\":\"8930\",\"notes\":\"Travelling with an infant\",\"created_at\":\"2026-11-08 09:05:00\"},{\"id\":19,\"booking_ref\":\"WW-26-1019\",\"customer_id\":6,\"customer_name\":\"Hina Raza\",\"agent_id\":2,\"agent_name\":\"Sara Malik\",\"destination\":\"Baku, Azerbaijan\",\"hotel\":\"Caspian Pearl\",\"depart_date\":\"2026-12-04\",\"return_d