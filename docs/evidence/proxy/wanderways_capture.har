                        "mimeType": "text/css; charset=utf-8",
                        "text": ":root {\n  --bg: #f4f6fa;\n  --surface: #ffffff;\n  --text: #1c2433;\n  --muted: #667085;\n  --line: #e3e7ef;\n  --brand: #0f6cbd;\n  --brand-dark: #0b4f8a;\n  --danger: #c0392b;\n  --ok: #1e8e5a;\n  --warn: #b7791f;\n  --radius: 10px;\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  background: var(--bg);\n  color: var(--text);\n  line-height: 1.5;\n}\n\na { color: var(--brand); }\n\n.lab-banner {\n  background: #fff4e5;\n  color: #8a5300;\n  font-size: 0.8rem;\n  text-align: center;\n  padding: 4px 16px;\n  border-bottom: 1px solid #f5d9a8;\n}\n\n.topbar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 14px 24px;\n  background: var(--surface);\n  border-bottom: 1px solid var(--line);\n}\n\n.brand { font-size: 1.3rem; font-weight: 700; color: var(--text); text-decoration: none; }\n.brand span { color: var(--brand); }\n.brand small { font-weight: 500; color: var(--muted); font-size: 0.85rem; }\n\nnav { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }\nnav a { text-decoration: none; font-weight: 500; }\nnav .who { color: var(--muted); font-size: 0.9rem; }\n\n.role {\n  display: inline-block;\n  padding: 1px 8px;\n  border-radius: 999px;\n  font-size: 0.75rem;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n.role-admin { background: #fde8e8; color: #9b1c1c; }\n.role-agent { background: #e6f0fb; color: var(--brand-dark); }\n.role-customer { background: #e7f6ee; color: #146c43; }\n\n.container { max-width: 1080px; margin: 24px auto; padding: 0 16px; }\n\n.card {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  padding: 20px 24px;\n  margin-bottom: 20px;\n}\n.card.narrow { max-width: 440px; margin: 40px auto; }\n.card-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }\n\nh1 { font-size: 1.4rem; margin: 0 0 12px; }\nh2 { font-size: 1.1rem; margin: 0 0 12px; }\n.muted { color: var(--muted); }\n\n.table-wrap { overflow-x: auto; }\ntable { width: 100%; border-collapse: collapse; font-size: 0.92rem; }\nth, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }\nth { color: var(--muted); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }\ntbody tr:hover { background: #f8fafd; }\n\n.badge { padding: 2px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; }\n.badge-confirmed { background: #e7f6ee; color: var(--ok); }\n.badge-pending { background: #fdf3e1; color: var(--warn); }\n.badge-cancelled { background: #fde8e8; color: var(--danger); }\n\nform label { display: block; font-weight: 500; font-size: 0.9rem; margin-bottom: 12px; }\ninput, select {\n  display: block;\n  width: 100%;\n  margin-top: 4px;\n  padding: 9px 10px;\n  font: inherit;\n  border: 1px solid #cfd6e3;\n  border-radius: 8px;\n  background: #fff;\n}\ninput:focus, select:focus { outline: 2px solid #b9d6f2; border-color: var(--brand); }\n\n.grid-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0 16px; }\n.grid-form .wide { grid-column: 1 / -1; }\n.actions { display: flex; gap: 10px; flex-wrap: wrap; }\n\nbutton, .button {\n  display: inline-block;\n  padding: 9px 18px;\n  font: inherit;\n  font-weight: 600;\n  color: #fff;\n  background: var(--brand);\n  border: 0;\n  border-radius: 8px;\n  cursor: pointer;\n  text-decoration: none;\n}\nbutton:hover, .button:hover { background: var(--brand-dark); }\nbutton.danger { background: var(--danger); }\n\n.details { display: grid; grid-template-columns: max-content 1fr; gap: 6px 24px; margin: 0; }\n.details dt { color: var(--muted); }\n.details dd { margin: 0; font-weight: 500; }\n\n.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-top: 8px; }\n.stat { border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; }\n.stat .label { color: var(--muted); font-size: 0.8rem; }\n.stat .value { font-size: 1.4rem; font-weight: 700; }\n\n.message { padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; }\n.message.error { background: #fde8e8; color: #9b1c1c; }\n.message.success { background: #e7f6ee; color: #146c43; }\n\nfooter { text-align: center; color: var(--muted); font-size: 0.8rem; padding: 24px 16px 40px; }\n"
