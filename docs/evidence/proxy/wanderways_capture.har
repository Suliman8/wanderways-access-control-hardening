                        "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Bookings \u00b7 WanderWays Travel</title>\n  <link rel=\"stylesheet\" href=\"/static/css/style.css\">\n</head>\n<body data-page=\"dashboard\" data-user-id=\"4\">\n  <div class=\"lab-banner\">Training lab \u00b7 intentionally vulnerable \u00b7 run on 127.0.0.1 only</div>\n  <header class=\"topbar\">\n    <a class=\"brand\" href=\"/\">Wander<span>Ways</span> <small>Travel</small></a>\n    \n    <nav>\n      <a href=\"/dashboard\">Bookings</a>\n      <a href=\"/bookings/new\">New booking</a>\n      <a href=\"/profile\">Profile</a>\n      \n      <span class=\"who\">Ayesha Khan <span class=\"role role-customer\">customer</span></span>\n      <a id=\"logout-link\" class=\"logout\" href=\"/logout\">Log out</a>\n    </nav>\n    \n  </header>\n  <main class=\"container\">\n    <div id=\"page-message\" class=\"message\" hidden></div>\n    \n<section class=\"card\">\n  <div class=\"card-head\">\n    <h1>\n      My bookings\n    </h1>\n    <span id=\"booking-count\" class=\"muted\"></span>\n  </div>\n  <div class=\"table-wrap\">\n    <table>\n      <thead>\n        <tr><th>Ref</th><th>Customer</th><th>Destination</th><th>Dates</th><th>Travellers</th><th>Total</th><th>Status</th></tr>\n      </thead>\n      <tbody id=\"bookings-body\"><tr><td colspan=\"7\" class=\"muted\">Loading\u2026</td></tr></tbody>\n    </table>\n  </div>\n</section>\n\n  </main>\n  <footer>WanderWays Travel \u00b7 internal booking prototype \u00b7 Ezitech</footer>\n  <script src=\"/static/js/app.js\"></script>\n</body>\n</html>"
